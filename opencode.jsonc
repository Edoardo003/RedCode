{
  "$schema": "https://opencode.ai/config.json",

  // ── Providers ──────────────────────────────────────────────────
  "provider": {
    // Local Qwen 3.5 9B via LM Studio — uncensored, for PoC generation
    "lm-studio": {
      "api": "{env:LM_STUDIO_URL}",
      "name": "LM Studio (Qwen 3.5 9B Uncensored Aggressive)",
      "npm": "@ai-sdk/openai-compatible",
      "env": [],
      "models": {
        "qwen3.5-9b-uncensored-hauhaucs-aggressive": {
          "name": "Qwen 3.5 9B Uncensored (Aggressive)",
          "id": "qwen3.5-9b-uncensored-hauhaucs-aggressive",
          "tool_call": true,
          "temperature": true,
          "reasoning": false,
          "attachment": false,
          "cost": { "input": 0, "output": 0 },
          "limit": { "context": 32768, "output": 8192 },
        },
      },
      "options": {
        "apiKey": "lm-studio",
      },
    },
  },

  // ── MCP Servers ────────────────────────────────────────────────
  "mcp": {
    // HexStrike AI — 150+ security tools (nmap, nuclei, sqlmap, gobuster, etc.)
    "hexstrike": {
      "type": "local",
      "command": [
        "python3",
        "hexstrike-ai/hexstrike_mcp.py",
        "--server",
        "http://localhost:8888",
      ],
    },

    // Filesystem — read/write output directory for reports and results
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "./output",
        "./templates",
        "./wordlists",
      ],
    },

    // Brave Search — OSINT, CVE lookup, exploit research, bug bounty write-ups
    "brave-search": {
      "type": "local",
      "command": ["npx", "-y", "@brave/brave-search-mcp-server"],
      "environment": {
        "BRAVE_API_KEY": "{env:BRAVE_API_KEY}",
      },
    },

    // Playwright — browser automation for verifying web vulns, screenshots, auth flows
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest", "--headless"],
    },

    // Fetch — HTTP client for testing API endpoints, custom requests
    "fetch": {
      "type": "local",
      "command": ["mcp-server-fetch"],
    },

    // SQLite — persist findings, scan history, target tracking across sessions
    "sqlite": {
      "type": "local",
      "command": ["mcp-server-sqlite", "--db-path", "{env:REDCODE_DB}"],
    },
  },

  // ── Agent Configuration ────────────────────────────────────────
  // Full agent prompts live in .opencode/agent/*.md
  // mode is set in each agent's frontmatter — primary = tab-switchable
  "default_agent": "redcode",

  "agent": {
    "redcode": {
      "model": "github-copilot/claude-sonnet-4-6",
    },

    "recon": {
      "model": "github-copilot/claude-sonnet-4-6",
      "steps": 30,
    },

    "scanner": {
      "model": "github-copilot/claude-sonnet-4-6",
      "steps": 40,
    },

    "exploiter": {
      "model": "github-copilot/o3",
      "steps": 25,
    },

    "poc": {
      "model": "lm-studio/qwen3.5-9b-uncensored-hauhaucs-aggressive",
      "steps": 15,
    },

    "reporter": {
      "model": "github-copilot/claude-sonnet-4-6",
      "steps": 20,
    },
  },
}
