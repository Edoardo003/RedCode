{
  "$schema": "https://opencode.ai/config.json",

  // ── Providers ──────────────────────────────────────────────────
  // ── MCP Servers ────────────────────────────────────────────────
  "mcp": {
    // HexStrike AI — 150+ security tools (nmap, nuclei, sqlmap, gobuster, etc.)
    "hexstrike": {
      "type": "local",
      "command": [
        "python3",
        "hexstrike-ai/hexstrike_mcp.py",
        "--server",
        "{env:HEXSTRIKE_URL}",
      ],
      "timeout": 86400000,
    },

    // Filesystem — read/write output directory for reports and results
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "./output",
        "./templates",
        "./wordlists",
      ],
    },

    // Playwright — browser automation for verifying web vulns, screenshots, auth flows
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest", "--headless"],
    },

    // Fetch — HTTP client for testing API endpoints, custom requests
    "fetch": {
      "type": "local",
      "command": ["mcp-server-fetch"],
    },

    // SQLite — persist findings, scan history, target tracking across sessions
    "sqlite": {
      "type": "local",
      "command": ["mcp-server-sqlite", "--db-path", "{env:REDCODE_DB}"],
    },

    // Burp Suite — manual HTTP request verification, proxy history, repeater
    "burp": {
      "type": "remote",
      "url": "{env:BURP_MCP_URL}",
      "enabled": false,
      "timeout": 120000,
    },
  },

  // ── Agent Configuration ────────────────────────────────────────
  // Full agent prompts live in .opencode/agent/*.md
  // mode is set in each agent's frontmatter — primary = tab-switchable
  "default_agent": "redcode",

  "agent": {
    "redcode": {
      "model": "opencode-go/kimi-k2.7-code",
    },

    "recon": {
      "model": "opencode-go/kimi-k2.6",
      "steps": 40,
    },

    "scanner": {
      "model": "opencode-go/kimi-k2.7-code",
      "steps": 50,
    },

    "exploiter": {
      "model": "opencode-go/deepseek-v4-pro",
      "steps": 50,
    },

    "osint": {
      "model": "opencode-go/qwen3.7-plus",
      "steps": 50,
    },

    "socialeng": {
      "model": "opencode-go/qwen3.7-plus",
      "steps": 40,
    },

    "reporter": {
      "model": "opencode-go/glm-5.2",
      "steps": 30,
    },

    "templates": {
      "model": "opencode-go/kimi-k2.7-code",
      "steps": 15,
    },

    // Compaction agent keeps long assessment summaries coherent.
    "compaction": {
      "model": "opencode-go/kimi-k2.6",
    },
  },
}
