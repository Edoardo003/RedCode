{
  "$schema": "https://opencode.ai/config.json",

  // MCP servers
  "mcp": {
    // HexStrike MCP client connected to the configured HTTP backend.
    "hexstrike": {
      "type": "local",
      "command": [
        "python3",
        "hexstrike-ai/hexstrike_mcp.py",
        "--server",
        "{env:HEXSTRIKE_URL}",
      ],
      "timeout": 86400000,
    },

    // Filesystem access is limited to generated output, templates, and wordlists.
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem@2026.7.10",
        "./output",
        "./templates",
        "./wordlists",
      ],
    },

    // Headless browser automation for analyst-reviewed web verification.
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@0.0.78", "--headless"],
    },

    // HTTP retrieval for in-scope resources.
    "fetch": {
      "type": "local",
      "command": ["mcp-server-fetch"],
    },

    // SQLite persistence for findings, scan history, and target tracking.
    "sqlite": {
      "type": "local",
      "command": ["mcp-server-sqlite", "--db-path", "{env:REDCODE_DB}"],
    },

    // Optional Burp MCP for proxy history, request analysis, and reviewed Repeater work.
    "burp": {
      "type": "remote",
      "url": "{env:BURP_MCP_URL}",
      "enabled": true,
      "timeout": 120000,
    },
  },

  // Agent configuration
  // Full agent prompts live in .opencode/agent/*.md.
  // Mode is set in each agent's frontmatter; primary agents are tab-switchable.
  "default_agent": "redcode",

  // Keep recent working context while pruning stale tool output after compaction.
  // Agent iteration limits remain role-specific and are intentionally unchanged.
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000,
  },

  // MCP servers are opt-in per agent below. This reduces irrelevant tool schemas
  // in each model context and prevents accidental cross-role tool use.
  "permission": {
    "hexstrike_*": "deny",
    "filesystem_*": "deny",
    "playwright_*": "deny",
    "fetch_*": "deny",
    "sqlite_*": "deny",
    "burp_*": "deny",
  },

  "agent": {
    "redcode": {
      "model": "opencode-go/kimi-k2.7-code",
      "permission": {
        "filesystem_*": "allow",
        "sqlite_*": "allow",
      },
    },

    "recon": {
      "model": "opencode-go/kimi-k2.6",
      "steps": 40,
      "permission": {
        "hexstrike_*": "allow",
        "filesystem_*": "allow",
        "fetch_*": "allow",
        "sqlite_*": "allow",
      },
    },

    "scanner": {
      "model": "opencode-go/kimi-k2.7-code",
      "steps": 50,
      "permission": {
        "hexstrike_*": "allow",
        "filesystem_*": "allow",
        "playwright_*": "allow",
        "fetch_*": "allow",
        "sqlite_*": "allow",
        "burp_*": "allow",
      },
    },

    "exploiter": {
      "model": "opencode-go/deepseek-v4-pro",
      "steps": 50,
      "permission": {
        "hexstrike_*": "allow",
        "filesystem_*": "allow",
        "playwright_*": "allow",
        "fetch_*": "allow",
        "sqlite_*": "allow",
        "burp_*": "allow",
      },
    },

    "bugbounty": {
      "model": "opencode-go/kimi-k2.7-code",
      "steps": 80,
      "permission": {
        "filesystem_*": "allow",
        "sqlite_*": "allow",
        "hexstrike_*": "deny",
        "playwright_*": "deny",
        "fetch_*": "deny",
        "burp_*": "deny",
      },
    },

    "osint": {
      "model": "opencode-go/qwen3.7-plus",
      "steps": 50,
      "permission": {
        "hexstrike_*": "allow",
        "filesystem_*": "allow",
        "playwright_*": "allow",
        "fetch_*": "allow",
        "sqlite_*": "allow",
      },
    },

    "socialeng": {
      "model": "opencode-go/qwen3.7-plus",
      "steps": 40,
      "permission": {
        "filesystem_*": "allow",
        "playwright_*": "allow",
        "sqlite_*": "allow",
      },
    },

    "ctf": {
      "model": "opencode-go/kimi-k2.7-code",
      "steps": 60,
      "permission": {
        "hexstrike_*": "allow",
        "filesystem_*": "allow",
        "playwright_*": "allow",
        "fetch_*": "allow",
        "sqlite_*": "allow",
      },
    },

    "reporter": {
      "model": "opencode-go/glm-5.2",
      "steps": 30,
      "permission": {
        "filesystem_*": "allow",
        "sqlite_*": "allow",
      },
    },

    "templates": {
      "model": "opencode-go/kimi-k2.7-code",
      "steps": 15,
      "permission": {
        "filesystem_*": "allow",
        "sqlite_*": "allow",
      },
    },

    // Compaction agent keeps long assessment summaries coherent.
    "compaction": {
      "model": "opencode-go/kimi-k2.6",
    },
  },
}
