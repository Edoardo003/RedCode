# RedCode — Environment Variables
# Copy this file to .env and fill in the values.

# LM Studio endpoint (local uncensored model for PoC generation)
LM_STUDIO_URL=http://10.10.10.55:1234/v1

# Brave Search API key (free tier: https://brave.com/search/api/)
# Used by @recon and @exploiter for OSINT, CVE lookup, exploit research
BRAVE_API_KEY=

# HexStrike API server URL
HEXSTRIKE_URL=http://localhost:8888

# SQLite database path for persisting findings across sessions
REDCODE_DB=./redcode.db

# Bugcrowd API credentials (token pair from https://bugcrowd.com/user/integrations)
# NOTE: Bugcrowd REST API and AI Connect require team/organization access.
# Disabled by default for researcher accounts. Uncomment if you have access.
#BUGCROWD_API_USERNAME=
#BUGCROWD_API_PASSWORD=

# HackerOne API credentials (from https://docs.hackerone.com/hackers/api)
# Used by @reporter and bug bounty workflows to read programs and manage reports
HACKERONE_API_USERNAME=
HACKERONE_API_TOKEN=

# Burp Suite MCP server URL
# Requires the PortSwigger MCP Server extension enabled in Burp Suite.
# Set host to 0.0.0.0 in Burp MCP advanced options to allow remote connections.
BURP_MCP_URL=http://10.10.10.100:9876

# Proxy for IP rotation (optional)
# Supports: SOCKS5 (tor), HTTP proxy, Webshare rotating proxy
# Examples:
#   PROXY_URL=socks5://127.0.0.1:9050                        (Tor)
#   PROXY_URL=http://127.0.0.1:8080                          (Burp/ZAP/mitmproxy)
#   PROXY_URL=http://user-rotate:pass@p.webshare.io:80       (Webshare rotating — auto IP rotation)
# Leave empty to disable proxy
PROXY_URL=
