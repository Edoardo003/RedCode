# RedCode environment variables
# Copy this file to .env and review the values.

# HexStrike backend: local on this machine, or lan on another trusted host.
HEXSTRIKE_MODE=local
HEXSTRIKE_URL=http://127.0.0.1:8888

# Local Arsenal origin used by the optional mediated integration profile.
# Phase 7C accepts loopback hosts only. The workspace is selected at launch.
ARSENAL_URL=http://127.0.0.1:8000
# Embedded Arsenal chat gateway. The file is created on first gateway start with 0600.
# REDCODE_GATEWAY_TOKEN_FILE=/home/user/.local/share/redcode/chat-gateway-token
# Usually auto-discovered at $XDG_DATA_HOME/arsenal/agent-token.
# Set this only if Arsenal uses a custom data directory.
ARSENAL_AGENT_TOKEN_FILE=

# SQLite database path for persisting findings across sessions.
REDCODE_DB=./redcode.db

# Active engagement manifest used by doctor and scope preflight commands.
REDCODE_ENGAGEMENT=./engagement.json

# Trusted Burp MCP server on the security-tools VLAN. setup.sh asks for the
# exact address; replace this example before starting RedCode.
BURP_MCP_URL=http://10.10.10.10:9876

# Every process launched through ./redcode, and every command started by a
# local HexStrike backend, is prefixed with this command. proxychains4 must be
# installed on the machine hosting RedCode and HexStrike. Leave it set unless
# that host exposes a compatible wrapper.
REDCODE_COMMAND_PREFIX="proxychains4 -q"

# Optional proxy URL. The redcode launcher exports standard HTTP proxy
# environment variables; support varies by underlying tool.
# Examples:
#   PROXY_URL=socks5://127.0.0.1:9050
#   PROXY_URL=http://127.0.0.1:8080
# Leave empty to disable proxy.
PROXY_URL=
