{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "darkBg": "#0B0D10",
    "darkPanel": "#12161B",
    "darkElement": "#191E24",
    "darkText": "#E6E9ED",
    "darkMuted": "#87919D",
    "darkRed": "#E5484D",
    "darkRedSoft": "#FF6B70",
    "lightBg": "#F7F8FA",
    "lightPanel": "#FFFFFF",
    "lightElement": "#ECEFF3",
    "lightText": "#171A1F",
    "lightMuted": "#66707C",
    "lightRed": "#C9363E",
    "lightRedDeep": "#A8242C"
  },
  "theme": {
    "primary": { "dark": "darkRed", "light": "lightRed" },
    "secondary": { "dark": "darkRedSoft", "light": "lightRedDeep" },
    "accent": { "dark": "#42B8D5", "light": "#16708A" },
    "error": { "dark": "#FF5C62", "light": "#B4232C" },
    "warning": { "dark": "#E5A84B", "light": "#A96600" },
    "success": { "dark": "#38A169", "light": "#257A45" },
    "info": { "dark": "#42B8D5", "light": "#16708A" },
    "text": { "dark": "darkText", "light": "lightText" },
    "textMuted": { "dark": "darkMuted", "light": "lightMuted" },
    "background": { "dark": "darkBg", "light": "lightBg" },
    "backgroundPanel": { "dark": "darkPanel", "light": "lightPanel" },
    "backgroundElement": { "dark": "darkElement", "light": "lightElement" },
    "border": { "dark": "#343B44", "light": "#C8CED6" },
    "borderActive": { "dark": "darkRed", "light": "lightRed" },
    "borderSubtle": { "dark": "#252B32", "light": "#DEE2E7" },
    "diffAdded": { "dark": "#38A169", "light": "#257A45" },
    "diffRemoved": { "dark": "#E5484D", "light": "#C9363E" },
    "diffContext": { "dark": "#87919D", "light": "#66707C" },
    "diffHunkHeader": { "dark": "#42B8D5", "light": "#16708A" },
    "diffHighlightAdded": { "dark": "#183C28", "light": "#DDF3E5" },
    "diffHighlightRemoved": { "dark": "#461F23", "light": "#F8DFE1" },
    "diffAddedBg": { "dark": "#102A1C", "light": "#EAF7EF" },
    "diffRemovedBg": { "dark": "#32181B", "light": "#FCECEE" },
    "diffContextBg": { "dark": "darkBg", "light": "lightBg" },
    "diffLineNumber": { "dark": "#66707C", "light": "#87919D" },
    "diffAddedLineNumberBg": { "dark": "#183C28", "light": "#DDF3E5" },
    "diffRemovedLineNumberBg": { "dark": "#461F23", "light": "#F8DFE1" },
    "markdownText": { "dark": "darkText", "light": "lightText" },
    "markdownHeading": { "dark": "darkRedSoft", "light": "lightRedDeep" },
    "markdownLink": { "dark": "#42B8D5", "light": "#16708A" },
    "markdownLinkText": { "dark": "#72C8DA", "light": "#125D73" },
    "markdownCode": { "dark": "#F0B75C", "light": "#8C5700" },
    "markdownBlockQuote": { "dark": "darkMuted", "light": "lightMuted" },
    "markdownEmph": { "dark": "#FFFFFF", "light": "#0B0D10" },
    "markdownStrong": { "dark": "#FFFFFF", "light": "#0B0D10" },
    "markdownHorizontalRule": { "dark": "#343B44", "light": "#C8CED6" },
    "markdownListItem": { "dark": "darkRedSoft", "light": "lightRed" },
    "markdownListEnumeration": { "dark": "#42B8D5", "light": "#16708A" },
    "markdownImage": { "dark": "#72C8DA", "light": "#125D73" },
    "markdownImageText": { "dark": "darkMuted", "light": "lightMuted" },
    "markdownCodeBlock": { "dark": "darkText", "light": "lightText" },
    "syntaxComment": { "dark": "darkMuted", "light": "lightMuted" },
    "syntaxKeyword": { "dark": "darkRedSoft", "light": "lightRedDeep" },
    "syntaxFunction": { "dark": "#72C8DA", "light": "#125D73" },
    "syntaxVariable": { "dark": "darkText", "light": "lightText" },
    "syntaxString": { "dark": "#6FCF97", "light": "#257A45" },
    "syntaxNumber": { "dark": "#F0B75C", "light": "#8C5700" },
    "syntaxType": { "dark": "#C69AF4", "light": "#6E3AA8" },
    "syntaxOperator": { "dark": "#B5BDC7", "light": "#4D5661" },
    "syntaxPunctuation": { "dark": "#B5BDC7", "light": "#4D5661" }
