#!/usr/bin/env bash
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [ -f "$DIR/.env" ]; then
  set -a
  source "$DIR/.env"
  set +a
fi

: "${HEXSTRIKE_URL:=http://localhost:8888}"
: "${REDCODE_DB:=$DIR/redcode.db}"
: "${REDCODE_ENGAGEMENT:=$DIR/engagement.json}"
: "${REDCODE_COMMAND_PREFIX:=proxychains4 -q}"
: "${ARSENAL_URL:=http://127.0.0.1:8000}"
: "${ARSENAL_SESSION:=$DIR/output/.redcode/current-arsenal-session.json}"
: "${ARSENAL_WORKSPACE:=}"
: "${REDCODE_MODE:=}"
: "${PROXY_URL:=}"
export HEXSTRIKE_URL REDCODE_DB REDCODE_ENGAGEMENT REDCODE_COMMAND_PREFIX
export ARSENAL_URL ARSENAL_SESSION ARSENAL_WORKSPACE REDCODE_MODE PROXY_URL

# All processes launched through this entry point receive the configured prefix.
# Use a simple space-separated executable and arguments (the default is
# "proxychains4 -q"); parsing never uses eval, so shell metacharacters are not
# interpreted. Local state commands are prefixed too to keep launcher behavior
# consistent, although most of them do not make network requests.
declare -a REDCODE_PREFIX
read -r -a REDCODE_PREFIX <<< "$REDCODE_COMMAND_PREFIX"
if [ "${#REDCODE_PREFIX[@]}" -eq 0 ] || ! command -v "${REDCODE_PREFIX[0]}" >/dev/null 2>&1; then
  echo "RedCode command-prefix error: cannot run '$REDCODE_COMMAND_PREFIX'. Install proxychains4 or set REDCODE_COMMAND_PREFIX to a compatible wrapper." >&2
  exit 127
fi

run_with_prefix() {
  "${REDCODE_PREFIX[@]}" "$@"
}

exec_with_prefix() {
  exec "${REDCODE_PREFIX[@]}" "$@"
}

# setup.sh installs Python dependencies here. Keeping it on PATH also lets
# OpenCode resolve the Python-based MCP server executables.
if [ -d "$DIR/.venv/bin" ]; then
  export PATH="$DIR/.venv/bin:$PATH"
fi

# OpenCode's installer uses this user-local location by default. Add it for
# non-interactive shells (for example SSH) without overriding a system install.
if [ -d "$HOME/.opencode/bin" ]; then
  export PATH="$HOME/.opencode/bin:$PATH"
fi

# Export standard proxy env vars so tools that read http_proxy/https_proxy get proxy support for free
if [ -n "$PROXY_URL" ]; then
  export http_proxy="$PROXY_URL"
  export https_proxy="$PROXY_URL"
  export HTTP_PROXY="$PROXY_URL"
  export HTTPS_PROXY="$PROXY_URL"
fi

case "${1:-}" in
  gateway)
    shift
    exec_with_prefix python3 "$DIR/scripts/redcode_gateway.py" "$@"
    ;;
  doctor|db|engagement|scope|arsenal|runtime)
    exec_with_prefix python3 "$DIR/scripts/redcode_control.py" "$@"
    ;;
  bugbounty)
    exec_with_prefix python3 "$DIR/scripts/bugbounty_control.py" "${@:2}"
    ;;
  stats)
    shift
    if [ "${1:-}" = "--all" ]; then
      shift
      exec_with_prefix opencode stats "$@"
    fi
    exec_with_prefix opencode stats --project "$DIR" "$@"
    ;;
esac

MODE="$REDCODE_MODE"
WORKSPACE="$ARSENAL_WORKSPACE"
OPENCODE_ARGS=()

while [ "$#" -gt 0 ]; do
  case "$1" in
    --mode)
      if [ "$#" -lt 2 ]; then
        echo "redcode: --mode requires standalone or arsenal" >&2
        exit 2
      fi
      MODE="$2"
      shift 2
      ;;
    --arsenal-url)
      if [ "$#" -lt 2 ]; then
        echo "redcode: --arsenal-url requires an origin" >&2
        exit 2
      fi
      ARSENAL_URL="$2"
      shift 2
      ;;
    --workspace)
      if [ "$#" -lt 2 ]; then
        echo "redcode: --workspace requires an Arsenal workspace id" >&2
        exit 2
      fi
      WORKSPACE="$2"
      shift 2
      ;;
    --)
      shift
      OPENCODE_ARGS+=("$@")
      break
      ;;
    *)
      OPENCODE_ARGS+=("$1")
      shift
      ;;
  esac
done

if [ -z "$MODE" ]; then
  if [ -t 0 ]; then
    echo "How do you want to start RedCode?"
    echo
    echo "  1. Standalone (direct HexStrike tools)"
    echo "  2. Arsenal (mediated workspace session)"
    echo
    read -r -p "Selection [1]: " selection
    case "${selection:-1}" in
      1) MODE="standalone" ;;
      2) MODE="arsenal" ;;
      *) echo "redcode: invalid mode selection" >&2; exit 2 ;;
    esac
  else
    MODE="standalone"
  fi
fi

case "$MODE" in
  standalone)
    export REDCODE_MODE="standalone"
    run_with_prefix python3 "$DIR/scripts/redcode_control.py" runtime activate \
      --mode standalone --quiet
    ;;
  arsenal)
    connect_args=(
      arsenal connect
      --url "$ARSENAL_URL"
      --session "$ARSENAL_SESSION"
      --quiet
    )
    if [ -n "$WORKSPACE" ]; then
      connect_args+=(--workspace "$WORKSPACE")
    fi
    run_with_prefix python3 "$DIR/scripts/redcode_control.py" "${connect_args[@]}"
    export REDCODE_MODE="arsenal" ARSENAL_URL ARSENAL_SESSION
    export ARSENAL_WORKSPACE="$WORKSPACE"
    OPENCODE_CONFIG_CONTENT="$(
      run_with_prefix python3 "$DIR/scripts/redcode_control.py" arsenal opencode-config
    )"
    export OPENCODE_CONFIG_CONTENT
    ;;
  *)
    echo "redcode: unsupported mode '$MODE' (expected standalone or arsenal)" >&2
    exit 2
    ;;
esac

if [ "$MODE" = "standalone" ] && [ -f "$REDCODE_ENGAGEMENT" ]; then
  run_with_prefix python3 "$DIR/scripts/redcode_control.py" engagement activate \
    --file "$REDCODE_ENGAGEMENT" --quiet
fi

exec_with_prefix opencode "${OPENCODE_ARGS[@]}"
