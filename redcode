#!/usr/bin/env bash
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [ -f "$DIR/.env" ]; then
  set -a
  source "$DIR/.env"
  set +a
fi

: "${LM_STUDIO_URL:=http://10.10.10.55:1234/v1}"
: "${HEXSTRIKE_URL:=http://localhost:8888}"
: "${REDCODE_DB:=$DIR/redcode.db}"
: "${BRAVE_API_KEY:=}"
: "${PROXY_URL:=}"
export LM_STUDIO_URL HEXSTRIKE_URL REDCODE_DB BRAVE_API_KEY PROXY_URL

# Export standard proxy env vars so tools that read http_proxy/https_proxy get proxy support for free
if [ -n "$PROXY_URL" ]; then
  export http_proxy="$PROXY_URL"
  export https_proxy="$PROXY_URL"
  export HTTP_PROXY="$PROXY_URL"
  export HTTPS_PROXY="$PROXY_URL"
fi

exec opencode "$@"
